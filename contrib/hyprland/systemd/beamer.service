[Unit]
Description=Beamer keyboard mouse and clipboard sharing
After=graphical-session.target xdg-desktop-portal.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/beamer --hidden
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
